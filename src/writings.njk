---
layout: base.njk
title: Writings
pageClass: page-writings
permalink: /writings/
---
<section class="writings">
  <p class="page-eyebrow">Behind the research</p>
  <h1 class="page-title">Writings</h1>
  <p class="page-intro">A closer look at the methods, experiments, and ideas behind my work on speech AI security.</p>
  <ul class="post-list">
    {% for post in collections.posts %}
      {% if not post.data.hideFromWritings %}
      <li class="post-item">
        {% if post.data.thumbnail %}<a class="post-thumbnail" href="{{ post.url }}" tabindex="-1" aria-hidden="true"><img src="{{ post.data.thumbnail }}" alt="" width="420" height="280" loading="lazy"></a>{% endif %}
        <div class="post-summary">
          {% if post.data.period %}<span class="post-date post-period">{{ post.data.period }}</span>{% else %}<time class="post-date" datetime="{{ post.date | isoDate }}">{{ post.date | shortDate }}</time>{% endif %}
          <h2><a class="post-link" href="{{ post.url }}">{{ post.data.title }}</a></h2>
          {% if post.data.description %}<p class="post-description" lang="{{ post.data.lang or 'en' }}">{{ post.data.description }}</p>{% endif %}
          <a class="post-read" href="{{ post.url }}" aria-label="Read: {{ post.data.title }}">Read story <span aria-hidden="true">→</span></a>
        </div>
      </li>
      {% endif %}
    {% endfor %}
  </ul>
</section>
